{
  "patterns": [
    {
      "id": "bank_account",
      "name": "银行账号",
      "description": "16-19位数字银行卡/账号",
      "regex": "(?<!\\d)\\d{16,19}(?!\\d)",
      "enabled": true
    },
    {
      "id": "phone",
      "name": "手机号码",
      "description": "11位手机号",
      "regex": "(?<!\\d)1[3-9]\\d{9}(?!\\d)",
      "enabled": true
    },
    {
      "id": "id_card",
      "name": "身份证号",
      "description": "18位身份证号码",
      "regex": "(?<!\\d)\\d{17}[\\dXx](?![\\dXx])",
      "enabled": true
    },
    {
      "id": "iban",
      "name": "IBAN账号",
      "description": "国际银行账号",
      "regex": "\\b[A-Z]{2}\\d{2}[A-Z0-9]{4,30}\\b",
      "enabled": true
    },
    {
      "id": "swift_code",
      "name": "SWIFT代码",
      "description": "银行SWIFT/BIC代码",
      "regex": "\\b[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?\\b",
      "enabled": true
    }
  ],
  "keywords": [
    {
      "id": "payer_name",
      "name": "付款方户名",
      "labels": ["付款人", "付款方", "汇款人", "付款户名", "付款人名称", "付款方名称"],
      "action": "redact_value",
      "enabled": true
    },
    {
      "id": "payer_account",
      "name": "付款方账号",
      "labels": ["付款账号", "付款方账号", "汇款账号", "付款人账号"],
      "action": "redact_value",
      "enabled": true
    },
    {
      "id": "payer_bank",
      "name": "付款方开户行",
      "labels": ["付款行", "付款方开户行", "汇款行", "付款人开户行"],
      "action": "redact_value",
      "enabled": true
    },
    {
      "id": "payee_name",
      "name": "收款方户名",
      "labels": ["收款人", "收款方", "收款户名", "收款人名称", "收款方名称"],
      "action": "redact_value",
      "enabled": false
    },
    {
      "id": "payee_account",
      "name": "收款方账号",
      "labels": ["收款账号", "收款方账号", "收款人账号"],
      "action": "redact_value",
      "enabled": false
    }
  ],
  "replacement": "****"
}
